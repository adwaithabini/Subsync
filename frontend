const Dashboard = () => {
  const initialMetrics = {
    activeUsers: 128,
    uptimePercent: 99.9,
    errorsToday: 2,
    newSubscriptions: 17,
  };

  const initialActivities = [
    "User 'Amala' subscribed to Pro Plan.",
    "Error: Failed payment for user 'Rajan'.",
    "Server uptime check passed.",
    "User 'Divya' updated profile settings.",
    "New workspace created by 'Arun'.",
  ];

  const [metrics, setMetrics] = useState(initialMetrics);
  const [activities, setActivities] = useState(initialActivities);
  const [serviceRunning, setServiceRunning] = useState(true);
  const [shortcutCount, setShortcutCount] = useState(0);

  // simulate live metrics update every 7 seconds
  useEffect(() => {
    const interval = setInterval(() => {
      setMetrics((prev) => ({
        ...prev,
        activeUsers: Math.max(
          100,
          Math.min(9999, prev.activeUsers + ((Math.random() * 10 - 5) | 0))
        ),
        errorsToday: Math.max(0, prev.errorsToday + (Math.random() > 0.7 ? 1 : 0)),
      }));
    }, 7000);
    return () => clearInterval(interval);
  }, []);

  function handleToggleService(enabled) {
    setServiceRunning(enabled);
    setActivities((acts) => [`Service ${enabled ? "started" : "stopped"}.`, ...acts]);
  }

  function handleShortcut() {
    setShortcutCount((c) => c + 1);
    setActivities((acts) => [`Shortcut action triggered (${shortcutCount + 1})`, ...acts]);
  }

  return (
    <main className="ml-20 p-8 min-h-screen bg-[#0f172a]">
      <h2 className="text-4xl font-semibold mb-8 font-sans">Dashboard</h2>

      {/* Summary Cards */}
      <section className="grid grid-cols-4 gap-6 mb-12">
        {[
          { label: "Active Users", value: metrics.activeUsers },
          { label: "Uptime %", value: metrics.uptimePercent.toFixed(2) },
          { label: "Errors Today", value: metrics.errorsToday },
          { label: "New Subscriptions", value: metrics.newSubscriptions },
        ].map(({ label, value }) => (
          <div
            key={label}
            className="p-6 rounded-xl bg-white/10 backdrop-blur-md border border-white/20 shadow-[0_0_15px_#0ff]"
          >
            <h3 className="text-xl mb-1">{label}</h3>
            <p className="font-bold text-3xl">{value}</p>
          </div>
        ))}
      </section>

      {/* Service Toggle */}
      <section className="mb-12">
        <h3 className="text-2xl mb-2 font-sans">Service Status</h3>
        <StatusToggle
          enabled={serviceRunning}
          onChange={handleToggleService}
          label="Toggle Service Running Status"
        />
        <p className="mt-3">
          The core service is currently: <strong>{serviceRunning ? "Running" : "Stopped"}</strong>
        </p>
      </section>

      {/* Shortcuts */}
      <section className="mb-12">
        <h3 className="text-2xl mb-3 font-sans">Quick Actions</h3>
        <button
          onClick={handleShortcut}
          className="px-5 py-3 bg-cyan-400 rounded-lg shadow-[0_0_10px_#0ff] font-semibold hover:bg-cyan-500 transition"
          aria-label="Trigger shortcut action"
        >
          Trigger Shortcut
        </button>
      </section>

      {/* Recent Activities */}
      <section>
        <h3 className="text-2xl mb-3 font-sans">Recent Activity Log</h3>
        <ul className="max-h-48 overflow-y-auto space-y-2 border border-white/20 rounded-xl p-4 bg-white/10 backdrop-blur-md shadow-[0_0_15px_#0ff]">
          {activities.length === 0 ? (
            <p>No recent activities.</p>
          ) : (
            activities.map((act, i) => (
              <li
                key={i}
                className="text-sm text-cyan-400 border-l-4 border-cyan-400 pl-3 italic"
              >
                {act}
              </li>
            ))
          )}
        </ul>
      </section>
    </main>
  );
};

const Workspace = () => {
  /*
  Configuration list saved to local storage.
  Task list with statuses.
  Real-time status meters.
  Loading spinner states.
  New task inputs.
  */

  const STORAGE_KEY = "workspaceData";

  const defaultConfigs = [
    { id: 1, setting: "Enable Sync", value: true },
    { id: 2, setting: "Max Retries", value: 3 },
    { id: 3, setting: "Timeout (s)", value: 30 },
  ];

  const initialTable = [
    { id: 1, task: "Fetch user data", status: "Completed" },
    { id: 2, task: "Sync payment info", status: "Pending" },
    { id: 3, task: "Refresh dashboard", status: "In Progress" },
  ];

  const [configs, setConfigs] = useState(loadFromLocalStorage(STORAGE_KEY, defaultConfigs));
  const [table, setTable] = useState(initialTable);
  const [loadingId, setLoadingId] = useState(null);
  const [newTask, setNewTask] = useState("");
  const [statusFilter, setStatusFilter] = useState("All");

  useEffect(() => {
    saveToLocalStorage(STORAGE_KEY, configs);
  }, [configs]);

  // Toggle config (boolean)
  const toggleConfig = (id) => {
    setConfigs((cfs) =>
      cfs.map((c) =>
        c.id === id
          ? { ...c, value: typeof c.value === "boolean" ? !c.value : c.value }
          : c
      )
    );
  };

  // Set numeric config
  const changeNumberConfig = (id, val) => {
    if (!isNaN(val) && val >= 0) {
      setConfigs((cfs) => cfs.map((c) => (c.id === id ? { ...c, value: val } : c)));
    }
  };

  // Start task: simulate async update with spinner
  const startTask = (id) => {
    setLoadingId(id);
    // Also update status to "In Progress"
    setTable((t) =>
      t.map((task) =>
        task.id === id && task.status !== "Completed"
          ? { ...task, status: "In Progress" }
          : task
      )
    );

    setTimeout(() => {
      setTable((t) =>
        t.map((task) =>
          task.id === id ? { ...task, status: "Completed" } : task
        )
      );
      setLoadingId(null);
    }, 2500);
  };

  // Add new task
  const addTask = () => {
    if (!newTask.trim()) return;
    const newId = table.length ? Math.max(...table.map((t) => t.id)) + 1 : 1;
    setTable([{ id: newId, task: newTask.trim(), status: "Pending" }, ...table]);
    setNewTask("");
  };

  // Filtered tasks
  const filteredTasks = statusFilter === "All" ? table : table.filter((t) => t.status === statusFilter);

  function StatusMeter({ value, max, label }) {
    const pct = Math.min(100, (value / max) * 100);
    return (
      <div className="p-4 rounded-xl bg-white/10 backdrop-blur-md border border-white/20 shadow-[0_0_15px_#0ff]">
        <h4 className="font-semibold mb-1">{label}</h4>
        <div className="w-full bg-gray-700 rounded-full h-4 overflow-hidden">
          <div
            className="bg-cyan-400 h-4 rounded-full shadow-[0_0_8px_#0ff] transition-all"
            style={{ width: pct + "%" }}
            aria-valuenow={value}
            aria-valuemin={0}
            aria-valuemax={max}
            role="progressbar"
          />
        </div>
        <p className="mt-1 text-sm text-right font-mono text-cyan-400">
          {value} / {max}
        </p>
      </div>
    );
  }

  return (
    <main className="ml-20 p-8 max-w-5xl mx-auto min-h-screen space-y-10 bg-[#0f172a]">
      <h2 className="text-4xl font-semibold mb-6 font-sans">Subsync Workspace</h2>

      {/* Configuration */}
      <section className="p-6 rounded-xl bg-white/10 backdrop-blur-md border border-white/20 shadow-[0_0_15px_#0ff]">
        <h3 className="text-2xl mb-4 font-sans">Configuration</h3>
        <div className="space-y-4">
          {configs.map(({ id, setting, value }) => (
            <div key={id} className="flex items-center justify-between">
              <span>{setting}</span>
              {typeof value === "boolean" ? (
                <button
                  onClick={() => toggleConfig(id)}
                  className={`relative inline-flex h-8 w-14 items-center rounded-full transition-shadow duration-300 ${
                    value ? "bg-cyan-400 shadow-[0_0_8px_#0ff]" : "bg-gray-700"
                  }`}
                  aria-pressed={value}
                  aria-label={`Toggle ${setting}`}
                >
                  <span
                    className={`inline-block h-6 w-6 transform rounded-full bg-[#0f172a] transition-transform ${
                      value ? "translate-x-6" : "translate-x-1"
                    }`}
                  />
                </button>
              ) : (
                <input
                  type="number"
                  className="w-20 rounded bg-transparent border border-white/30 px-2 py-1 text-right text-white focus:outline-none focus:ring-2 focus:ring-cyan-400"
                  value={value}
                  min={0}
                  onChange={(e) => changeNumberConfig(id, +e.target.value)}
                  aria-label={`Set value for ${setting}`}
                />
              )}
            </div>
          ))}
        </div>
      </section>

      {/* Status meters */}
      <section className="grid grid-cols-3 gap-6">
        <StatusMeter
          value={configs.find((c) => c.setting === "Max Retries")?.value || 0}
          max={10}
          label="Retries"
        />
        <StatusMeter
          value={configs.find((c) => c.setting === "Timeout (s)")?.value || 0}
          max={60}
          label="Timeout (seconds)"
        />
        <StatusMeter
          value={configs.find((c) => c.setting === "Enable Sync")?.value ? 1 : 0}
          max={1}
          label="Sync Enabled"
        />
      </section>

      {/* Task list */}
      <section className="">
        <h3 className="text-2xl mb-4 font-sans">Task List</h3>

        {/* Filter */}
        <div className="mb-4 flex gap-3 items-center">
          <label htmlFor="statusFilter" className="font-semibold select-none">
            Filter by Status:
          </label>
          <select
            id="statusFilter"
            value={statusFilter}
            onChange={(e) => setStatusFilter(e.target.value)}
            className="bg-transparent border border-white/30 rounded px-3 py-1 text-white focus:outline-none focus:ring-2 focus:ring-cyan-400"
          >
            <option>All</option>
            <option>Pending</option>
            <option>In Progress</option>
            <option>Completed</option>
          </select>
        </div>

        <table className="w-full text-left border-collapse rounded-lg overflow-hidden bg-white/10 backdrop-blur-md border border-white/20 shadow-[0_0_15px_#0ff]">
          <thead>
            <tr className="border-b border-white/20">
              <th className="px-4 py-2">Task</th>
              <th className="px-4 py-2">Status</th>
              <th className="px-4 py-2 text-center">Action</th>
            </tr>
          </thead>
          <tbody>
            {filteredTasks.length === 0 ? (
              <tr>
                <td
                  colSpan="3"
                  className="px-4 py-2 italic text-cyan-400 text-center select-none"
                >
                  No tasks with selected status.
                </td>
              </tr>
            ) : (
              filteredTasks.map(({ id, task, status }) => (
                <tr
                  key={id}
                  className="border-b border-white/10 hover:bg-white/10 transition select-none"
                >
                  <td className="px-4 py-2">{task}</td>
                  <td className="px-4 py-2 font-semibold">{status}</td>
                  <td className="px-4 py-2 text-center">
                    {loadingId === id ? (
                      <LoadingSpinner size={20} />
                    ) : (
                      <button
                        onClick={() => startTask(id)}
                        disabled={status === "Completed"}
                        className={`px-3 py-1 rounded ${
                          status === "Completed"
                            ? "bg-gray-500 cursor-not-allowed"
                            : "bg-cyan-400 hover:bg-cyan-600"
                        } transition text-black font-semibold`}
                        aria-label={`Start task ${task}`}
                      >
                        {status === "Completed" ? "Done" : "Start"}
                      </button>
                    )}
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>

        {/* Add task */}
        <div className="mt-6 flex gap-3">
          <input
            type="text"
            placeholder="New task description"
            className="flex-grow rounded bg-transparent border border-white/30 px-3 py-2 text-white focus:outline-none focus:ring-2 focus:ring-cyan-400"
            value={newTask}
            onChange={(e) => setNewTask(e.target.value)}
            aria-label="New task description"
          />
          <button
            onClick={addTask}
            disabled={!newTask.trim()}
            className={`px-5 py-2 rounded ${
              newTask.trim()
                ? "bg-cyan-400 hover:bg-cyan-600"
                : "bg-gray-600 cursor-not-allowed"
            } font-semibold transition`}
          >
            Add Task
          </button>
        </div>
      </section>
    </main>
  );
};

