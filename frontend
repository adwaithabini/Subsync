// ----- UTILS -----------------------------------
function saveToLocalStorage(key, data) {
  localStorage.setItem(key, JSON.stringify(data));
}

function loadFromLocalStorage(key, fallback) {
  try {
    const item = localStorage.getItem(key);
    if (item) return JSON.parse(item);
  } catch {}
  return fallback;
}

