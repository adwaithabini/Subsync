const Analytics = () => {
  const logsData = [
    { id: 1, description: "System boot completed", time: "09:00 AM" },
    { id: 2, description: "User Amala logged in", time: "09:14 AM" },
    { id: 3, description: "Data sync started", time: "09:30 AM" },
    { id: 4, description: "Payment processed", time: "10:00 AM" },
    { id: 5, description: "User Divya updated settings", time: "10:15 AM" },
  ];

  const [filter, setFilter] = useState("");
  const [filteredLogs, setFilteredLogs] = useState(logsData);

  function handleFilterChange(e) {
    const val = e.target.value;
    setFilter(val);
    setFilteredLogs(
      logsData.filter((log) =>
        log.description.toLowerCase().includes(val.toLowerCase())
      )
    );
  }

  function handleExport() {
    const csvContent =
      "data:text/csv;charset=utf-8," +
      ["id,description,time"]
        .concat(filteredLogs.map((l) => `${l.id},"${l.description}",${l.time}`))
        .join("\n");
    const encodedUri = encodeURI(csvContent);
    const link = document.createElement("a");
    link.href = encodedUri;
    link.download = "logs_export.csv";
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    toast.success("Logs exported successfully!");
  }

  return (
    <main className="ml-20 p-8 max-w-6xl mx-auto min-h-screen space-y-10 bg-[#0f172a]">
      <h2 className="text-4xl font-semibold mb-6 font-sans">Analytics & Logs</h2>

      {/* Chart */}
      <section>
        <AnalyticsChart />
      </section>

      {/* Logs */}
      <section>
        <h3 className="text-2xl mb-3 font-sans">Live Status Logs</h3>
        <div className="flex gap-4 mb-4 items-center max-w-md">
          <input
            type="text"
            placeholder="Filter logs"
            className="flex-grow rounded bg-transparent border border-white/30 px-3 py-2 text-white focus:outline-none focus:ring-2 focus:ring-cyan-400"
            value={filter}
            onChange={handleFilterChange}
            aria-label="Filter logs"
          />
          <button
            onClick={handleExport}
            className="px-4 py-2 rounded bg-cyan-400 hover:bg-cyan-600 shadow-[0_0_10px_#0ff] font-semibold transition"
          >
            Export CSV
          </button>
        </div>

        <ul className="max-h-64 overflow-y-auto border border-white/20 rounded-xl bg-white/10 backdrop-blur-md shadow-[0_0_15px_#0ff] p-4 space-y-2 text-sm divide-y divide-white/20">
          {filteredLogs.length === 0 && (
            <li className="italic text-center text-cyan-400 select-none">No logs found.</li>
          )}
          {filteredLogs.map(({ id, description, time }) => (
            <li key={id} className="flex justify-between py-1 select-none">
              <span>{description}</span>
              <time className="text-cyan-400 font-mono">{time}</time>
            </li>
          ))}
        </ul>
      </section>
    </main>
  );
};

const Settings = () => {
  const STORAGE_KEY = "userSettings";

  const defaultSettings = {
    username: "user123",
    email: "user@example.com",
    darkMode: true,
    notifications: true,
    language: "English",
  };

  const languages = ["English", "Spanish", "French", "German", "Hindi"];

  const [settings, setSettings] = useState(loadFromLocalStorage(STORAGE_KEY, defaultSettings));
  const [saving, setSaving] = useState(false);

  useEffect(() => {
    // Sync dark mode class on <html> element
    if (settings.darkMode) {
      document.documentElement.classList.add("dark");
    } else {
      document.documentElement.classList.remove("dark");
    }
  }, [settings.darkMode]);

  function handleChange(field, value) {
    setSettings((prev) => ({ ...prev, [field]: value }));
  }

  async function handleSave(e) {
    e.preventDefault();
    setSaving(true);
    // Simulate save delay
    await new Promise((r) => setTimeout(r, 1500));
    saveToLocalStorage(STORAGE_KEY, settings);
    toast.success("Settings saved!");
    setSaving(false);
  }

  return (
    <main className="ml-20 p-8 max-w-lg mx-auto min-h-screen space-y-8 bg-[#0f172a]">
      <h2 className="text-4xl font-semibold mb-8 font-sans">Settings & Preferences</h2>

      <form onSubmit={handleSave} className="space-y-6" aria-label="Settings form">
        {/* Username */}
        <div>
          <label htmlFor="username" className="block mb-2 font-semibold select-none">
            Username
          </label>
          <input
            id="username"
            type="text"
            className="w-full rounded bg-transparent border border-white/30 px-3 py-2 text-white focus:outline-none focus:ring-2 focus:ring-cyan-400"
            value={settings.username}
            onChange={(e) => handleChange("username", e.target.value)}
            required
            autoComplete="username"
          />
        </div>

        {/* Email */}
        <div>
          <label htmlFor="email" className="block mb-2 font-semibold select-none">
            Email
          </label>
          <input
            id="email"
            type="email"
            className="w-full rounded bg-transparent border border-white/30 px-3 py-2 text-white focus:outline-none focus:ring-2 focus:ring-cyan-400"
            value={settings.email}
            onChange={(e) => handleChange("email", e.target.value)}
            required
            autoComplete="email"
          />
        </div>

        {/* Dark Mode */}
        <div className="flex items-center justify-between">
          <span className="font-semibold select-none">Dark Mode</span>
          <StatusToggle
            enabled={settings.darkMode}
            onChange={(val) => handleChange("darkMode", val)}
            label="Toggle Dark Mode"
          />
        </div>

        {/* Notifications */}
        <div className="flex items-center justify-between">
          <span className="font-semibold select-none">Enable Notifications</span>
          <StatusToggle
            enabled={settings.notifications}
            onChange={(val) => handleChange("notifications", val)}
            label="Toggle Notifications"
          />
        </div>

        {/* Language */}
        <div>
          <label htmlFor="language" className="block mb-2 font-semibold select-none">
            Language
          </label>
          <select
            id="language"
            value={settings.language}
            onChange={(e) => handleChange("language", e.target.value)}
            className="w-full rounded bg-transparent border border-white/30 px-3 py-2 text-white focus:outline-none focus:ring-2 focus:ring-cyan-400"
          >
            {languages.map((lang) => (
              <option key={lang} value={lang}>
                {lang}
              </option>
            ))}
          </select>
        </div>

        {/* Save Button */}
        <button
          type="submit"
          disabled={saving}
          className={`w-full py-3 rounded font-semibold transition ${
            saving ? "bg-gray-600 cursor-not-allowed" : "bg-cyan-400 hover:bg-cyan-600"
          }`}
          aria-busy={saving}
        >
          {saving ? "Saving..." : "Save Settings"}
        </button>
      </form>
    </main>
  );
};

// ----- APP: MAIN ENTRY & ROUTER ------------------

export default function App() {
  // Add 'dark' mode class to document by default
  useEffect(() => {
    document.documentElement.classList.add("dark");
  }, []);

  // Scroll reset on route change (UX detail)
  const ScrollToTopOnRouteChange = () => {
    const { pathname } = useLocation();
    useEffect(() => window.scrollTo(0, 0), [pathname]);
    return null;
  };

  return (
    <BrowserRouter>
      <div className="flex min-h-screen font-sans">
        <Sidebar />
        <div className="flex-grow bg-[#0f172a] min-h-screen overflow-auto transition-colors duration-500">
          <ScrollToTopOnRouteChange />
          <Routes>
            <Route path="/" element={<Dashboard />} />
            <Route path="/workspace" element={<Workspace />} />
            <Route path="/analytics" element={<Analytics />} />
            <Route path="/settings" element={<Settings />} />
            <Route path="*" element={<Dashboard />} />
          </Routes>
        </div>
      </div>
      <Toasts />
    </BrowserRouter>
  );
}
